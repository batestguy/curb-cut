{
  "name": "curb-cut-site",
  "private": true,
  "version": "0.0.0",
  "description": "Curb Cut static site: accessible charts and tables for Nigerian disability data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-duckdb-extensions.mjs && node scripts/make-share-images.mjs",
    "share-images": "node scripts/make-share-images.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "plotly.js-basic-dist-min": "4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "vite": "8.3.2"
  }
}
